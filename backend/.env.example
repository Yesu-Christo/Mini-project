SECRET_KEY=your-secret-key-here
DEBUG=False
ALLOWED_HOSTS=campusshield-backend.onrender.com,.onrender.com,localhost,127.0.0.1
TIME_ZONE=Africa/Accra

CAMPUS_DEFAULT_LAT=6.6738
CAMPUS_DEFAULT_LNG=-1.5684

# CORS & CSRF — list all frontend origins separated by commas (no spaces)
CORS_ALLOWED_ORIGINS=https://campusshield-ai.vercel.app,https://campusshieldai.vercel.app,https://campusshield-ai-knust.vercel.app
FRONTEND_URL=https://campusshield-ai.vercel.app,https://campusshieldai.vercel.app,https://campusshield-ai-knust.vercel.app

# Email — SMTP via Gmail App Password
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=campusshield.knust@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=campusshield.knust@gmail.com
