# ============================================================
# CampusShield-AI — Frontend Environment Variables (EXAMPLE)
# ============================================================
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values appropriate for your environment.
# 3. NEVER commit your actual .env file.
# All variables MUST be prefixed with VITE_ to be exposed to
# the browser bundle via import.meta.env.

# --- API ---
VITE_API_BASE_URL=/api
VITE_API_TIMEOUT=10000

# --- Backend Dev Server (used by Vite proxy in development) ---
VITE_BACKEND_TARGET=http://localhost:8000

# --- Campus Map Defaults ---
# Centre coordinates used for the default map view and incident form.
# Change to your institution's coordinates if deploying elsewhere.
VITE_CAMPUS_DEFAULT_LAT=6.6738
VITE_CAMPUS_DEFAULT_LNG=-1.5684

# --- localStorage Key Names ---
VITE_TOKEN_KEY=cs_token
VITE_USER_KEY=cs_user

# --- Demo / Fallback Config ---
# Email domain used for demo user accounts when backend is offline
VITE_DEMO_EMAIL_DOMAIN=knust.edu.gh
