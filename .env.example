# ── Backend (Django / Render) ─────────────────────────────────────────────
SECRET_KEY=replace-this-with-a-secure-key
DEBUG=False
ALLOWED_HOSTS=campusshield-backend.onrender.com,.onrender.com,localhost,127.0.0.1
TIME_ZONE=Africa/Accra

# Database — set DATABASE_URL on Render to point at your Postgres instance.
# Use the Internal Database URL from the Render Postgres dashboard.
# Format: postgresql://USER:PASSWORD@HOSTNAME/DBNAME
# Leave unset locally — falls back to SQLite for development.
DATABASE_URL=postgresql://campusshield_db_76ji_user:your-password@dpg-dac76m0jo6nc73ctfik0-a/campusshield_db_76ji

# CORS & CSRF — comma-separated, no spaces, no trailing newlines
CORS_ALLOWED_ORIGINS=https://campusshield-ai.vercel.app,https://campusshieldai.vercel.app
FRONTEND_URL=https://campusshield-ai.vercel.app,https://campusshieldai.vercel.app

# Email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
EMAIL_HOST_USER=campusshield.knust@gmail.com
EMAIL_HOST_PASSWORD=your-gmail-app-password
DEFAULT_FROM_EMAIL=campusshield.knust@gmail.com

# Campus defaults
CAMPUS_DEFAULT_LAT=6.6738
CAMPUS_DEFAULT_LNG=-1.5684

# ── Frontend (React / Vercel) ─────────────────────────────────────────────
VITE_API_BASE_URL=https://campusshield-backend.onrender.com/api
VITE_API_TIMEOUT=10000
VITE_TOKEN_KEY=cs_token
